/* ========== 首页 ========== */
.page {
  padding: 8rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 悬浮小猫助手（可拖动） ---------- */
.cat-wrap {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 900;
  display: flex;
  flex-direction: column-reverse;   /* 默认气泡在小猫上方 */
  align-items: flex-end;
  pointer-events: none;
  transition: transform 0.3s cubic-bezier(.22,.61,.36,1);
}
.cat-wrap.down {
  flex-direction: column;           /* 小猫拖到屏幕上半部时气泡在下方 */
}
/* 拖动中：去掉过渡跟手、暂停浮动动画 */
.cat-wrap.dragging {
  transition: none;
}
.cat-wrap.dragging .cat-fab,
.cat-wrap.dragging .cat-fab-shadow {
  animation-play-state: paused;
}

/* 小猫本体 */
.cat-fab {
  position: relative;
  width: 124rpx;
  height: 124rpx;
  pointer-events: auto;
  animation: catFloat 4s ease-in-out infinite;
}
.cat-fab-shadow {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 76rpx;
  height: 18rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(30, 50, 110, 0.14);
  filter: blur(5rpx);
  animation: catShadow 4s ease-in-out infinite;
}
.cat-fab-body {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: #fdf3e6;
  border: 4rpx solid #fff;
  box-shadow: 0 10rpx 26rpx rgba(120, 100, 80, 0.22), 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  transition: transform 0.12s ease;
}
.cat-fab:active .cat-fab-body {
  transform: scale(0.92);
}
.cat-img {
  display: block;
  width: 100%;
  height: 100%;
}

.cat-fab.paused,
.cat-fab.paused .cat-fab-shadow {
  animation-play-state: paused;
}

@keyframes catFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8rpx); }
}
@keyframes catShadow {
  0%, 100% { transform: translateX(-50%) scale(1);    opacity: 0.14; }
  50%      { transform: translateX(-50%) scale(0.86); opacity: 0.08; }
}

/* ---------- 自动问候气泡 ---------- */
.cat-bubble {
  position: relative;
  pointer-events: auto;
  margin-bottom: 22rpx;
  width: 380rpx;
  padding: 22rpx 24rpx 20rpx;
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  background: #fff;
  border: 2rpx solid rgba(255, 196, 130, 0.5);
  box-shadow: 0 12rpx 32rpx rgba(235, 150, 60, 0.22);
  animation: bubblePop 0.45s cubic-bezier(.34,1.56,.64,1) both;
}
.cat-bubble-close {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  color: #999;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cat-bubble-hi {
  display: inline-block;
  font-size: 30rpx;
  font-weight: 800;
  color: #e8862e;
  margin-bottom: 6rpx;
}
.cat-bubble-text {
  font-size: 25rpx;
  line-height: 1.6;
  color: #4a3a2c;
  padding-right: 36rpx;
}
.cat-bubble-go {
  display: inline-block;
  margin-top: 14rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb057, #ff8f3d);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(255, 143, 61, 0.35);
}
.cat-bubble-tail {
  position: absolute;
  right: 34rpx;
  bottom: -14rpx;
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 16rpx solid #fff;
  filter: drop-shadow(0 4rpx 3rpx rgba(235, 150, 60, 0.15));
}
/* 气泡在小猫下方时：尾巴朝上 */
.cat-wrap.down .cat-bubble {
  margin-top: 22rpx;
  margin-bottom: 0;
  border-radius: 8rpx 28rpx 28rpx 28rpx;
}
.cat-wrap.down .cat-bubble-tail {
  top: -14rpx;
  bottom: auto;
  border-top: none;
  border-bottom: 16rpx solid #fff;
}

@keyframes bubblePop {
  0%   { transform: scale(0.6) translateY(20rpx); opacity: 0; }
  100% { transform: scale(1)   translateY(0);    opacity: 1; }
}

/* ---------- Hero ---------- */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 36rpx 34rpx 34rpx;
  color: #fff;
  background: linear-gradient(135deg, #1b2b83 0%, #3457cf 45%, #17a7cf 100%);
  box-shadow: 0 18rpx 44rpx rgba(36, 72, 180, 0.35);
}

.hero::after {
  content: '';
  position: absolute;
  left: -60rpx;
  bottom: -90rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.14), transparent 65%);
}

.orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.orb-a {
  width: 200rpx;
  height: 200rpx;
  right: -60rpx;
  top: -80rpx;
  background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.05) 60%, transparent 70%);
  animation: floatY 7s ease-in-out infinite;
}
.orb-b {
  width: 120rpx;
  height: 120rpx;
  right: 130rpx;
  bottom: -46rpx;
  background: radial-gradient(circle at 40% 40%, rgba(115, 255, 236, 0.5), rgba(30, 200, 220, 0.12) 65%, transparent 75%);
  animation: floatY 9s ease-in-out 1s infinite;
}
.ring {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  right: -90rpx;
  bottom: -130rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.28);
  border-radius: 50%;
  animation: ring 30s linear infinite;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  position: relative;
  z-index: 1;
}
.hero-date {
  font-size: 22rpx;
  opacity: 0.85;
  letter-spacing: 1rpx;
}
.hero-badge {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-weight: 600;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
  position: relative;
  z-index: 1;
}

.hero-stats {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  padding: 20rpx 8rpx;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(6rpx);
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 38rpx;
  font-weight: 800;
  font-family: Georgia, 'Times New Roman', serif;
}
.stat-label {
  font-size: 20rpx;
  opacity: 0.85;
  margin-top: 2rpx;
}
.stat-div {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.28);
}

/* ---------- 横向滚动容器 ---------- */
.hstrip {
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
}
.hstrip-inner {
  display: inline-flex;
  padding: 8rpx 24rpx 18rpx;
}

/* 最近使用卡片 */
.recent-card {
  flex: none;
  width: 300rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-right: 20rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
}
.tile-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  margin-right: 18rpx;
}
.recent-mid {
  flex: 1;
  min-width: 0;
}
.recent-name {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-time {
  font-size: 20rpx;
  color: var(--ink3);
  margin-top: 4rpx;
}

/* ---------- 筛选 ---------- */
.filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

/* ---------- 计算器宫格 ---------- */
.calc-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.calc-card {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 26rpx;
  padding: 24rpx 22rpx 22rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}
.calc-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(70, 110, 255, 0.07), rgba(30, 190, 220, 0.05));
}
.calc-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.tile-calc {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}
.calc-name {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.calc-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 精选词条 ---------- */
.hot-card {
  flex: none;
  width: 430rpx;
  background: #fff;
  border-radius: 26rpx;
  padding: 24rpx;
  margin-right: 20rpx;
  box-shadow: var(--shadow-sm);
}
.hot-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hot-cat {
  font-size: 20rpx;
  color: var(--ink3);
}
.hot-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.hot-summary {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 手册分类 ---------- */
.cat-list {
  margin-top: 10rpx;
}
.cat-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 26rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.cat-mid {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.cat-name {
  font-size: 31rpx;
  font-weight: 700;
}
.cat-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cat-arrow {
  font-size: 44rpx;
  color: #c3cbdf;
  margin-left: 12rpx;
  font-family: Georgia, serif;
}
