/* pages/assistant/assistant.wxss — 对话页样式 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ---------- 顶部条 ---------- */
.tipbar {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  background: linear-gradient(135deg, rgba(61, 99, 255, 0.08), rgba(26, 169, 216, 0.06));
  border-bottom: 1rpx solid var(--line);
}
.tipbar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #16c79e;
  margin-right: 14rpx;
  box-shadow: 0 0 0 4rpx rgba(22, 199, 158, 0.18);
  animation: softPulse 1.6s ease-in-out infinite;
}
.tipbar-text {
  font-size: 24rpx;
  color: var(--ink2);
  letter-spacing: 1rpx;
}
.tipbar-clear {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink3);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.04);
}

/* ---------- 消息流 ---------- */
.stream {
  flex: 1;
  min-height: 0;
}
.stream-inner {
  padding: 24rpx 28rpx 32rpx;
}

.msg {
  display: flex;
  margin-bottom: 26rpx;
  align-items: flex-start;
}

/* 用户消息右靠 */
.msg-u {
  justify-content: flex-end;
}
.msg-u .msg-text {
  max-width: 78%;
  padding: 18rpx 24rpx;
  border-radius: 24rpx 24rpx 6rpx 24rpx;
  background: var(--grad);
  color: #fff;
  font-size: 28rpx;
  line-height: 1.55;
  box-shadow: 0 6rpx 14rpx rgba(61, 99, 255, 0.28);
  word-break: break-word;
  white-space: pre-wrap;
}

/* AI 消息 */
.avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4d66ff, #1bb6d8);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  box-shadow: 0 6rpx 14rpx rgba(61, 99, 255, 0.22);
}
.ai-body {
  flex: 1;
  min-width: 0;
}
.ai-tool {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(61, 99, 255, 0.1);
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}
.ai-text {
  background: #fff;
  border-radius: 6rpx 24rpx 24rpx 24rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink);
  box-shadow: var(--shadow-sm);
  word-break: break-word;
  white-space: pre-wrap;
  display: block;
}
.ai-bold {
  font-weight: 700;
  color: var(--brand);
}

/* 打字指示 */
.typing {
  display: inline-flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx 24rpx 24rpx 24rpx;
  padding: 18rpx 22rpx;
  box-shadow: var(--shadow-sm);
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a3b3df;
  margin: 0 4rpx;
  animation: typingDot 1.2s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.30s; }
@keyframes typingDot {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-6rpx); opacity: 1; }
}

/* ---------- 卡片 ---------- */
.card {
  display: flex;
  align-items: stretch;
  margin-top: 16rpx;
  padding: 18rpx 18rpx 18rpx 18rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
  position: relative;
  overflow: hidden;
}
.card-primary {
  border: none;
  background: linear-gradient(135deg, rgba(61, 99, 255, 0.10), rgba(26, 169, 216, 0.08));
  box-shadow: 0 10rpx 28rpx rgba(61, 99, 255, 0.18);
}
.card-primary::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 6rpx;
  height: 100%;
  background: var(--grad);
}
.card-sys {
  display: block;
  background: rgba(61, 99, 255, 0.04);
  border-style: dashed;
  border-color: rgba(61, 99, 255, 0.16);
}
.card-muted {
  background: rgba(0, 0, 0, 0.03);
  color: var(--ink3);
  font-size: 22rpx;
}
.card-muted .card-title { color: var(--ink3); font-size: 22rpx; }
.card-muted .card-line  { font-family: monospace; font-size: 22rpx; }

.card-icon {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--grad);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  font-family: Georgia, serif;
}
.card-icon-entry {
  background: linear-gradient(135deg, #f59f00, #e5484d);
  font-family: -apple-system;
  font-size: 42rpx;
}
.card-mid {
  flex: 1;
  min-width: 0;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 4rpx;
}
.card-sub {
  font-size: 22rpx;
  color: var(--ink3);
  margin-bottom: 8rpx;
}
.card-line {
  font-size: 24rpx;
  color: var(--ink2);
  line-height: 1.7;
  word-break: break-word;
}
.card-go {
  flex: none;
  margin-left: 14rpx;
  align-self: center;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

/* ---------- 推荐（首屏） ---------- */
.promote {
  margin: 30rpx 12rpx;
}
.promote-title {
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
  margin: 20rpx 0 14rpx;
}
.promote-grid {
  display: flex;
  flex-wrap: wrap;
}
.promote-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(61, 99, 255, 0.08);
  color: var(--ink);
  font-size: 24rpx;
  margin: 0 14rpx 14rpx 0;
  border: 1rpx solid transparent;
}
.calcs {
  display: flex;
  flex-direction: column;
  margin: 0 -4rpx;
}
.calc-pill {
  display: flex;
  align-items: center;
  padding: 16rpx 18rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
}
.calc-pill-ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  font-family: Georgia, serif;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(40, 70, 170, 0.20);
}
.calc-pill-nm {
  font-size: 26rpx;
  color: var(--ink);
  flex: 1;
}

.stream-foot {
  text-align: center;
  color: var(--ink3);
  font-size: 22rpx;
  padding: 30rpx 0 16rpx;
  letter-spacing: 2rpx;
}

/* ---------- 输入栏 ---------- */
.composer {
  flex: none;
  background: #fff;
  border-top: 1rpx solid var(--line);
  padding: 16rpx 22rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 14rpx rgba(30, 62, 150, 0.05);
}
.composer-inner {
  display: flex;
  align-items: center;
}
.composer-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.composer-send {
  flex: none;
  margin-left: 16rpx;
  width: 110rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(61, 99, 255, 0.12);
  color: var(--ink3);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
}
.composer-send.on {
  background: var(--grad);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(61, 99, 255, 0.28);
}
