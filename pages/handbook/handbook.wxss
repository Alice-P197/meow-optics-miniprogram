/* ========== 手册详情页 ========== */
.page {
  padding: 8rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* 词条头图 */
.top-hero {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  padding: 36rpx 34rpx 78rpx;
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(40, 70, 180, 0.28);
  animation: popIn 0.6s cubic-bezier(0.2, 0.85, 0.3, 1.2) both;
}
.th-orb {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  right: -70rpx;
  top: -90rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.35), transparent 70%);
  animation: floatY 8s ease-in-out infinite;
}
.th-ribbon {
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  right: -120rpx;
  bottom: -180rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  animation: ring 36s linear infinite;
}
.th-tag {
  display: inline-block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  position: relative;
  z-index: 1;
}
.th-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

/* 正文卡 */
.content {
  position: relative;
  z-index: 2;
  margin-top: -40rpx;
  background: #fff;
  border-radius: 34rpx;
  padding: 40rpx 34rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(30, 62, 150, 0.12);
}

.b-p {
  font-size: 28rpx;
  color: #2a3557;
  line-height: 1.85;
  margin-bottom: 24rpx;
  text-align: justify;
}

.b-h3 {
  font-size: 31rpx;
  font-weight: 800;
  color: var(--ink);
  margin: 40rpx 0 18rpx;
  display: flex;
  align-items: center;
}
.b-h3::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: var(--grad);
  margin-right: 14rpx;
}
.b-h2 {
  font-size: 34rpx;
  font-weight: 800;
  margin: 44rpx 0 20rpx;
}

/* 公式 */
.b-f {
  margin: 26rpx 0;
  background: linear-gradient(180deg, #f6f8ff, #eef3ff);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.b-f-eq {
  font-size: 32rpx;
  font-style: italic;
  color: #1d2f7d;
  letter-spacing: 1rpx;
  text-align: center;
  word-break: break-all;
}

/* 提示 */
.b-note {
  display: flex;
  align-items: flex-start;
  background: #f0f6ff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin: 26rpx 0;
  font-size: 24rpx;
  color: #3b5aa0;
  line-height: 1.7;
}
.b-note-bar {
  flex: none;
  width: 8rpx;
  height: auto;
  align-self: stretch;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #4a7cff, #38c9ad);
  margin-right: 18rpx;
}

/* 列表 */
.b-list {
  margin: 22rpx 0;
}
.b-li {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  color: #35405f;
  line-height: 1.7;
}
.b-li-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), var(--brand2));
  margin: 15rpx 18rpx 0 4rpx;
  box-shadow: 0 0 0 5rpx rgba(61, 99, 255, 0.12);
}
.b-li-txt {
  flex: 1;
}

/* 表格 */
.b-tbl-wrap {
  margin: 24rpx 0;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-sm);
}
.b-tr {
  display: flex;
  align-items: stretch;
}
.b-td {
  flex: 1;
  min-width: 0;
  padding: 16rpx 14rpx;
  font-size: 22rpx;
  color: #35405f;
  line-height: 1.5;
  border-right: 1rpx solid var(--line);
  word-break: break-all;
}
.b-td:last-child {
  border-right: none;
}
.b-td.fix {
  flex: none;
}
.b-th {
  background: linear-gradient(135deg, #f0f4ff, #f6f8ff);
  font-weight: 700;
  color: #23386e;
  border-bottom: 2rpx solid var(--line);
}
.b-th .b-td {
  font-weight: 700;
}
.b-tr.alt {
  background: #fbfcff;
}

/* 代码块 */
.b-code {
  margin: 26rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #0f1530;
  box-shadow: 0 8rpx 24rpx rgba(15, 21, 48, 0.18);
}
.b-code-head {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  background: linear-gradient(180deg, #1a2148, #131838);
}
.b-code-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.b-code-dot-r { background: #ff5f56; }
.b-code-dot-y { background: #ffbd2e; }
.b-code-dot-g { background: #27c93f; }
.b-code-lang {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #a8b3d6;
  letter-spacing: 1rpx;
  font-family: monospace;
}
.b-code-copy {
  margin-left: auto;
  font-size: 22rpx;
  color: #a8b3d6;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
}
.b-code-body {
  padding: 8rpx 18rpx 18rpx;
  white-space: nowrap;
}
.b-code-pre {
  display: block;
  font-family: monospace;
  font-size: 22rpx;
  line-height: 1.6;
  color: #e6e9ff;
  white-space: pre;
}
