/* components/assistant-drawer/assistant-drawer.wxss */

.adw-root {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 9999;
}

/* ---------- 背景遮罩 ---------- */
.adw-backdrop {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(8, 16, 36, 0.42);
  opacity: 0;
  transition: opacity 280ms ease-out;
}
.adw-root.open .adw-backdrop {
  opacity: 1;
}

/* ---------- 抽屉面板（固定高度 88vh，键盘弹出时缩到 60vh 露出输入栏） ---------- */
.adw-panel {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 88vh;
  background: var(--bg);
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 20rpx 40rpx rgba(20, 40, 100, 0.20);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateY(-100%);
  opacity: 0;
  transition: transform 320ms cubic-bezier(.22,.61,.36,1), opacity 280ms ease-out, height 240ms cubic-bezier(.22,.61,.36,1);
}
/* 键盘弹出：面板整体收缩，让 composer 上移到键盘之上 */
.adw-panel.kbd {
  height: 60vh;
}
.adw-root.open .adw-panel {
  transform: translateY(0);
  opacity: 1;
}
/* 头部下拉拖拽中：禁用过渡，跟手移动 */
.adw-panel.dragging {
  transition: none;
}

/* ---------- 抽屉头部 ---------- */
.adw-head {
  flex: none;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx 18rpx;
  background: linear-gradient(135deg, #ff9f43, #ff7b39);
  color: #fff;
}
.adw-head-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.adw-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #fdf3e6;
  border: 3rpx solid rgba(255, 255, 255, 0.7);
  overflow: hidden;
  margin-right: 18rpx;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.15);
}
.adw-avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}
.adw-title {
  flex: 1;
  min-width: 0;
}
.adw-name {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}
.adw-state {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  opacity: 0.88;
  letter-spacing: 1rpx;
}
.adw-state-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #16c79e;
  margin-right: 8rpx;
  box-shadow: 0 0 0 4rpx rgba(22, 199, 158, 0.30);
  animation: softPulse 1.6s ease-in-out infinite;
}
.adw-head-right {
  display: flex;
  align-items: center;
}
.adw-icon-btn {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  font-weight: 600;
  margin-left: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.30);
}
.adw-close {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

/* ---------- 消息流 ---------- */
.adw-stream {
  flex: 1;
  /* height:0 + flex:1 → 高度完全由 flex 分配，绝不被内容撑开 */
  height: 0;
  min-height: 0;
}
.adw-stream-inner {
  padding: 22rpx 28rpx 24rpx;
}

.msg {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg-u { justify-content: flex-end; }
.msg-u .msg-text {
  max-width: 78%;
  padding: 16rpx 22rpx;
  border-radius: 24rpx 24rpx 6rpx 24rpx;
  background: var(--grad);
  color: #fff;
  font-size: 28rpx;
  line-height: 1.55;
  box-shadow: 0 6rpx 14rpx rgba(61, 99, 255, 0.28);
  word-break: break-word;
  white-space: pre-wrap;
}

.avatar {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #fdf3e6;
  border: 2rpx solid #ffd9ae;
  overflow: hidden;
  margin-right: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(120, 100, 80, 0.20);
}
.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}
.ai-body {
  flex: 1;
  min-width: 0;
}
.ai-tool {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(61, 99, 255, 0.10);
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}
.ai-text {
  background: #fff;
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--ink);
  box-shadow: var(--shadow-sm);
  word-break: break-word;
  white-space: pre-wrap;
  display: block;
}
.ai-bold {
  font-weight: 700;
  color: var(--brand);
}

.typing {
  display: inline-flex;
  align-items: center;
  background: #fff;
  border-radius: 18rpx 22rpx 22rpx 22rpx;
  padding: 16rpx 20rpx;
  box-shadow: var(--shadow-sm);
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a3b3df;
  margin: 0 4rpx;
  animation: typingDot 1.2s ease-in-out infinite;
}
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.30s; }
@keyframes typingDot {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-6rpx); opacity: 1; }
}
@keyframes softPulse {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(22, 199, 158, 0.18); }
  50% { box-shadow: 0 0 0 10rpx rgba(22, 199, 158, 0.05); }
}

/* ---------- 卡片 ---------- */
.card {
  display: flex;
  align-items: stretch;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--line);
  position: relative;
  overflow: hidden;
}
.card-primary {
  border: none;
  background: linear-gradient(135deg, rgba(61, 99, 255, 0.10), rgba(26, 169, 216, 0.08));
  box-shadow: 0 10rpx 28rpx rgba(61, 99, 255, 0.18);
}
.card-primary::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 6rpx; height: 100%;
  background: var(--grad);
}
.card-sys {
  display: block;
  background: rgba(61, 99, 255, 0.04);
  border-style: dashed;
  border-color: rgba(61, 99, 255, 0.16);
}
.card-muted {
  background: rgba(0, 0, 0, 0.03);
  color: var(--ink3);
  font-size: 22rpx;
}
.card-muted .card-title { color: var(--ink3); font-size: 22rpx; }
.card-muted .card-line  { font-family: monospace; font-size: 22rpx; }

.card-icon {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: var(--grad);
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-family: Georgia, serif;
}
.card-icon-entry {
  background: linear-gradient(135deg, #f59f00, #e5484d);
  font-family: -apple-system;
  font-size: 40rpx;
}
.card-mid {
  flex: 1;
  min-width: 0;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 4rpx;
}
.card-sub {
  font-size: 22rpx;
  color: var(--ink3);
  margin-bottom: 6rpx;
}
.card-line {
  font-size: 24rpx;
  color: var(--ink2);
  line-height: 1.65;
  word-break: break-word;
}
.card-go {
  flex: none;
  margin-left: 12rpx;
  align-self: center;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

/* ---------- 推荐（横向滑动） ---------- */
.promote { margin: 24rpx 0; }
.promote-title {
  font-size: 24rpx;
  color: var(--ink3);
  letter-spacing: 1rpx;
  margin: 16rpx 0 12rpx;
}
.promote-scroll {
  width: 100%;
  white-space: nowrap;
}
.promote-grid {
  display: inline-flex;
  padding-bottom: 8rpx;
}
.promote-chip {
  flex: none;
  white-space: nowrap;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(61, 99, 255, 0.08);
  color: var(--ink);
  font-size: 24rpx;
  margin: 0 12rpx 0 0;
  border: 1rpx solid transparent;
}
.calcs { display: flex; flex-direction: column; }
.calc-pill {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 10rpx;
  box-shadow: var(--shadow-sm);
}
.calc-pill-ic {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  font-family: Georgia, serif;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  box-shadow: 0 4rpx 10rpx rgba(40, 70, 170, 0.20);
}
.calc-pill-nm {
  font-size: 26rpx;
  color: var(--ink);
  flex: 1;
}

.stream-foot {
  text-align: center;
  color: var(--ink3);
  font-size: 22rpx;
  padding: 24rpx 0 12rpx;
  letter-spacing: 2rpx;
}

/* ---------- 回到底部悬浮按钮 ---------- */
.adw-tobot {
  position: absolute;
  right: 28rpx;
  bottom: 180rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(20, 40, 100, 0.18);
  border: 1rpx solid var(--line);
  opacity: 0;
  transform: translateY(16rpx) scale(0.8);
  pointer-events: none;
  transition: all 0.22s ease;
  z-index: 5;
}
.adw-tobot.on {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

/* ---------- 输入栏 ---------- */
.adw-composer {
  flex: none;
  background: #fff;
  border-top: 1rpx solid var(--line);
  padding: 14rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 14rpx rgba(30, 62, 150, 0.05);
}
.adw-composer-inner {
  display: flex;
  align-items: center;
}
.adw-composer-input {
  flex: 1;
  height: 70rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.adw-composer-send {
  flex: none;
  margin-left: 14rpx;
  width: 104rpx;
  height: 70rpx;
  border-radius: 36rpx;
  background: rgba(61, 99, 255, 0.12);
  color: var(--ink3);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
}
.adw-composer-send.on {
  background: var(--grad);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(61, 99, 255, 0.28);
}